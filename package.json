{
  "name": "sample-app-roles",
  "description": "Participant app for in-app roles. Admits signed-in users and provides the role sample screens for each role.",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "prisma generate && astro dev",
    "build": "prisma generate && astro build && pnpm run env:check:build",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "format": "prettier -w .",
    "lint": "eslint .",
    "test": "prisma generate && vitest run",
    "env:check:build": "esbuild participant-app-base/env-check --bundle --platform=node --format=esm --external:dotenv --outfile=dist/env-check.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "prisma": "^7.10.1",
    "astro": "^7.4.12",
    "dotenv": "^18.0.10",
    "participant-app-base": "file:../participant-app-base",
    "hono": "^4.13.19",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "astro-eslint-parser": "^3.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "typescript-eslint": "^8.73.0"
  }
}
